{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "jsx": "preserve"
  },
  "include": ["packages/**/src/**/*.ts", "packages/**/src/**/*.tsx", "packages/**/src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "apps", "**/*.test.*", "**/*.config.ts"]
}
