# Application
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/morgad

# DOKU Payment (Production Non-SNAP)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL="https://doku.com"

# Mayar Payment (Legacy compatibility)
MAYAR_ENV=sandbox
MAYAR_API_BASE=
MAYAR_API_KEY="your_legacy_mayar_api_key"
MAYAR_WEBHOOK_SECRET="your_legacy_mayar_webhook_secret"

# Download Security
DOWNLOAD_TOKEN_SECRET=your_very_long_random_secret_here_min_32_chars
DOWNLOAD_TOKEN_EXPIRY_DAYS=7

# Storage (S3-compatible: Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=https://your-account.r2.cloudflarestorage.com
STORAGE_BUCKET=morgad-private-files
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=auto

# Email (Resend / Postmark / SES)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your_email_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# Admin Session
ADMIN_SESSION_SECRET=your_very_long_admin_session_secret_here_min_32_chars
ADMIN_SESSION_EXPIRY_HOURS=8

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
